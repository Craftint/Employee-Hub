{
 "doctype": "DocType",
 "name": "HR Request",
 "module": "Employee Hub",
 "custom": 0,
 "istable": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "HR-REQ-.YYYY.-", "reqd": 1},
  {"fieldname": "employee", "fieldtype": "Link", "label": "Employee", "options": "Employee", "reqd": 1, "in_list_view": 1},
  {"fieldname": "employee_name", "fieldtype": "Data", "label": "Employee Name", "fetch_from": "employee.employee_name", "read_only": 1},
  {"fieldname": "request_type", "fieldtype": "Select", "label": "Request Type", "options": "Visa Renewal\nExit Permit\nSalary Certificate\nWarning Letter\nComplaint\nGeneral Request", "reqd": 1, "in_list_view": 1},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Open\nIn Progress\nApproved\nRejected\nClosed", "default": "Open", "in_list_view": 1, "read_only": 1},
  {"fieldname": "posting_date", "fieldtype": "Date", "label": "Date", "default": "Today", "in_list_view": 1},
  {"fieldname": "section_break_1", "fieldtype": "Section Break"},
  {"fieldname": "details", "fieldtype": "Text Editor", "label": "Details"},
  {"fieldname": "attachment", "fieldtype": "Attach", "label": "Attachment"}
 ],
 "permissions": [
  {"role": "Employee", "read": 1, "write": 1, "create": 1, "if_owner": 1, "delete": 0},
  {"role": "HR Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "HR User", "read": 1, "write": 1, "create": 1}
 ],
 "track_changes": 1
}
