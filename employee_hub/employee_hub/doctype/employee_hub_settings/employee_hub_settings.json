{
 "doctype": "DocType",
 "name": "Employee Hub Settings",
 "module": "Employee Hub",
 "custom": 0,
 "issingle": 1,
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "allow_personal_customization",
   "fieldtype": "Check",
   "label": "Allow Employees to Customize Their Own Layout",
   "default": "1",
   "description": "Uncheck this to stop employees from customizing their own view."
  },
  {
   "fieldname": "section_break_layout",
   "fieldtype": "Section Break",
   "label": "Global Default Layout"
  },
  {
   "fieldname": "layout_help",
   "fieldtype": "HTML",
   "options": "<p class='text-muted' style='margin-bottom:8px;'>This is what every employee sees by default. Edit the rows below to change what's shown and in what order.</p>"
  },
  {
   "fieldname": "global_default_layout",
   "fieldtype": "Table",
   "label": "Layout Items",
   "options": "Employee Hub Layout Item"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "select": 1,
   "read": 1,
   "write": 1,
   "report": 1,
   "print": 1
  }
 ],
 "track_changes": 1
}